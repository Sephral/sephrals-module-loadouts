{
  "id": "sephrals-module-loadouts",
  "title": "Sephral’s Module Loadouts",
  "description": "Save the active modules as named loadouts for one world or the whole installation, see what would change and switch with one click. Your previous setup is saved before every switch.",
  "version": "1.0.5",
  "compatibility": {
    "minimum": 13,
    "verified": "14.369"
  },
  "authors": [
    {
      "name": "Sephral"
    }
  ],
  "url": "https://github.com/Sephral/sephrals-module-loadouts.git",
  "esmodules": [
    "scripts/sml.js"
  ],
  "styles": [
    "styles/sml.css"
  ],
  "persistentStorage": true,
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "de",
      "name": "Deutsch",
      "path": "lang/de.json"
    }
  ]
}
